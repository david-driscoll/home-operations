#!/usr/bin/env bash
# private-domain-guard -- keep the estate's root domain and tailnet name out of
# every tracked file.
#
# WHY. This repo is public, and its history is being scrubbed of both names
# (docs/plans/private-domain-scrub.md). Their values live ONLY in SOPS:
# ROOT_DOMAIN and TAILSCALE_DOMAIN in kubernetes/flux/meta/shared-secrets.sops.yaml.
# This script reads them from there at run time, so it never contains them
# either, and it never prints matching text -- only paths and line numbers.
#
# What counts as a hit (case-insensitive extended regexes):
#   - the root domain in any spelling: a.b, a\.b, a\\.b, a-b, a_b (see patterns)
#   - the tailnet's first label (so the whole MagicDNS suffix, too)
#
# Usage:
#   private-domain-guard check [--cached]  scan tracked files (working tree, or
#                                          the index with --cached); fail on any
#                                          file not listed in the baseline
#   private-domain-guard stdin [path]      exit 1 if stdin contains a name (the
#                                          Claude Code Write/Edit hook); `path`,
#                                          repo-relative, applies the allow-list
#
# Exit codes: 0 clean, 1 found, 3 cannot decrypt (the caller decides; `check`
# and `stdin` both skip with a warning, so a machine without the age key is
# never blocked -- there is nothing it could compare against).
#
# The baseline (.config/private-domain-baseline) lists files that still hold a
# name on purpose, each waiting on a later phase of the plan. It only shrinks.
#
# The allow-list (.config/private-domain-allow) is not temporary. It names
# files that may spell the root domain as plain WORDS -- its labels separated
# by whitespace only, the way a display name is written -- and each entry is a
# decision David made. In those files every other spelling is still a hit, and
# so is the tailnet.
set -euo pipefail

# The repo this script lives in, whatever the caller's working directory (the
# Claude hook runs from anywhere; a worktree has its own copy).
top="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
secrets="$top/kubernetes/flux/meta/shared-secrets.sops.yaml"
baseline="$top/.config/private-domain-baseline"
allowlist="$top/.config/private-domain-allow"

# The entries of a list file: one path per line, `#` lines and blanks ignored.
entries() { [[ -r "$1" ]] && grep -v -e '^#' -e '^$' "$1" || true; }

load_names() {
  if [[ -n "${PRIVATE_DOMAIN_ROOT:-}" && -n "${PRIVATE_DOMAIN_TAILNET:-}" ]]; then
    root="$PRIVATE_DOMAIN_ROOT" tailnet="$PRIVATE_DOMAIN_TAILNET"
    return 0
  fi
  # .config/mise.toml points SOPS_AGE_KEY_FILE at a path that does not exist
  # in the agentboard pod; fall back to the pod's mounted key, then to sops'
  # own defaults.
  if [[ -n "${SOPS_AGE_KEY_FILE:-}" && ! -r "$SOPS_AGE_KEY_FILE" ]]; then
    if [[ -r /var/run/secrets/sops-age/age.agekey ]]; then
      export SOPS_AGE_KEY_FILE=/var/run/secrets/sops-age/age.agekey
    else
      unset SOPS_AGE_KEY_FILE
    fi
  fi
  local json
  json="$(sops -d --output-type json "$secrets" 2>/dev/null)" || return 3
  root="$(jq -r '.stringData.ROOT_DOMAIN // empty' <<<"$json")"
  tailnet="$(jq -r '.stringData.TAILSCALE_DOMAIN // empty' <<<"$json")"
  [[ -n "$root" && -n "$tailnet" ]] || return 3
}

# Extended regexes, one per line. The root domain's labels are joined by ANY
# one to four non-alphanumerics, so every spelling a file actually uses is
# caught: a.b, a\.b (a regex), a\\.b (a regex inside a YAML string -- the one
# a fixed-string list missed, in traefik's CORS middleware), a-b / a_b (slugs
# in secret paths and resource names). The tailnet's first label is
# distinctive enough to match alone.
#
# `patterns words-ok` is for allow-listed files: the separator must then hold
# at least one character that is not whitespace, so the name written as words
# no longer matches while every other spelling still does.
patterns() {
  local sep='[^a-z0-9]{1,4}' esc
  [[ "${1:-}" == words-ok ]] && sep='[^a-z0-9]{0,3}[^a-z0-9[:space:]][^a-z0-9]{0,3}'
  esc="$(printf '%s' "$root" | sed -E 's/[][\.^$*+?(){}|/]/\\&/g')"
  printf '%s\n' "${esc//\\./$sep}" "${tailnet%%.*}"
}

skip() {
  echo "private-domain-guard: cannot decrypt $secrets (no age key?) -- skipping" >&2
  exit 0
}

cmd="${1:-check}"
case "$cmd" in
  stdin)
    load_names || skip
    # The hook passes the target's repo-relative path, so an allow-listed file
    # is held to the same rule here as in `check`.
    kind=""
    if [[ -n "${2:-}" ]] && grep -qxF -- "$2" <(entries "$allowlist"); then kind="words-ok"; fi
    if grep -q -i -E -f <(patterns "$kind"); then exit 1; fi
    exit 0
    ;;
  check)
    load_names || skip
    mode=()
    [[ "${2:-}" == "--cached" ]] && mode=(--cached)
    words=()
    mapfile -t words < <(entries "$allowlist")
    # Allow-listed files get the words-ok patterns; everything else but SOPS
    # files gets the full set.
    hits="$(git -C "$top" grep "${mode[@]}" -I -i -n -E -f <(patterns) \
      -- . ':(exclude,glob)**/*.sops.*' "${words[@]/#/:(exclude,literal)}" | cut -d: -f1-2 || true)"
    if ((${#words[@]})); then
      hits+=$'\n'"$(git -C "$top" grep "${mode[@]}" -I -i -n -E -f <(patterns words-ok) \
        -- "${words[@]/#/:(literal)}" | cut -d: -f1-2 || true)"
      for f in "${words[@]}"; do
        git -C "$top" grep "${mode[@]}" -q -I -i -E -f <(patterns) -- ":(literal)$f" ||
          echo "private-domain-guard: $f no longer spells the name -- remove it from .config/private-domain-allow" >&2
      done
    fi
    baselined="$(entries "$baseline")"
    new="$(awk -F: 'NR==FNR { ok[$0]=1; next } !($1 in ok)' \
      <(printf '%s\n' "$baselined") <(printf '%s\n' "$hits") | grep -v '^$' || true)"
    stale="$(comm -23 <(printf '%s\n' "$baselined" | sort -u) \
      <(printf '%s\n' "$hits" | cut -d: -f1 | sort -u) | grep -v '^$' || true)"
    if [[ -n "$stale" ]]; then
      echo "private-domain-guard: now clean -- remove from .config/private-domain-baseline:" >&2
      sed 's/^/  /' <<<"$stale" >&2
    fi
    if [[ -n "$new" ]]; then
      echo "private-domain-guard: the root domain or tailnet name is written in plaintext at:" >&2
      sed 's/^/  /' <<<"$new" >&2
      cat >&2 <<'EOF'
Use ${ROOT_DOMAIN} / ${TAILSCALE_DOMAIN} in Flux-rendered values (SOPS-backed
via shared-secrets), <root domain> / <tailnet> in prose and comments, and read
them from the environment in code. See docs/plans/private-domain-scrub.md.
EOF
      exit 1
    fi
    ;;
  *)
    sed -n '2,/^set -euo pipefail$/{/^set /!p}' "$0" >&2
    exit 2
    ;;
esac
