#!/usr/bin/env bash
#
# vals-run — resolve every `ref+…` value in the environment, then exec.
#
#   mise exec -- ./scripts/vals-run pulumi preview --stack home-operations
#
# This is the `op run` replacement. `op run` substituted `op://` values found
# in the environment; `vals exec` only resolves what is in its `-f` file, so
# this builds that file from the environment and hands it over. The result is
# the same ergonomics with any backend vals supports: openbao, sops, op, and
# the rest — each value in .config/mise.toml names its own.
#
# The temp file holds REFERENCES, never resolved values — the secrets exist
# only in the environment vals hands to the child process. A real file rather
# than a pipe on purpose: `-f /dev/stdin` works, but then the child inherits a
# consumed stdin and anything interactive (a `pulumi up` confirmation) breaks.
set -Eeuo pipefail

[[ $# -gt 0 ]] || { printf 'usage: %s <command> [args…]\n' "$0" >&2; exit 2; }

# A temp DIRECTORY, not `mktemp <tpl>.yaml`: BSD mktemp requires the X's at the
# end of the template, so a suffixed template fails on macOS — where this
# script is mostly run. vals picks its parser from the extension, so the file
# has to keep one.
refsdir="$(mktemp -d "${TMPDIR:-/tmp}/vals-run.XXXXXX")"
refs="${refsdir}/refs.yaml"
trap 'rm -rf "${refsdir}"' EXIT

# Only variables whose value IS a reference. Everything else is already
# config and is inherited untouched via -i.
while IFS= read -r line; do
  name="${line%%=*}"
  value="${line#*=}"
  case "${value}" in ref+*) printf '%s: %s\n' "${name}" "$(printf '%s' "${value}" | sed 's/"/\\"/g; s/^/"/; s/$/"/')" >> "${refs}" ;; esac
done < <(env)

if [[ ! -s "${refs}" ]]; then
  # Nothing to resolve is not an error — but say so, because the alternative
  # is a silent run against unresolved config that fails much further along.
  printf 'vals-run: no ref+ values in the environment; running unchanged.\n' >&2
  exec "$@"
fi

exec vals exec -i -f "${refs}" -- "$@"
