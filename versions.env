# Cluster-wide Talos and Kubernetes versions, ported from equestria-cluster for
# piece 21 Phase B.
#
# Two consumers:
#   1. .taskfiles/talos/Taskfile.yaml reads this file directly (still in
#      equestria-cluster today; part of the non-Kubernetes tree merge).
#   2. kubernetes/components/common's configMapGenerator turns it into the
#      `cluster-versions` ConfigMap in every namespace, which cluster-apps
#      injects into every child HelmRelease/Kustomization as a
#      postBuild.substituteFrom source -- making ${KUBERNETES_VERSION} and
#      ${TALOS_VERSION} available estate-wide.
#
# NOTE: tuppr's TalosUpgrade/KubernetesUpgrade CRs in
# kubernetes/apps/system-upgrade/upgrades/ currently carry LITERAL versions
# with their own `# renovate:` annotations rather than referencing these
# variables -- so the same two versions are Renovate-managed in two places and
# must agree. They do today (v1.13.8 / v1.36.3). Collapsing them onto these
# variables is the obvious follow-up; until then, treat a mismatch between this
# file and those manifests as a bug.
#
# Renovate bumps these via the `.env` customManager pattern in
# .github/renovate.json5, which already matches this file.

# renovate: datasource=docker depName=ghcr.io/siderolabs/kubelet
KUBERNETES_VERSION=v1.36.3
# renovate: datasource=docker depName=ghcr.io/siderolabs/installer
TALOS_VERSION=v1.13.9
