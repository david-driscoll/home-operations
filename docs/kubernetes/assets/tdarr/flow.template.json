{
  "_id": "directPlayHevc",
  "name": "Direct Play HEVC",
  "priority": 0,
  "isUiLocked": false,
  "flowPlugins": [
    { "id": "dp-input", "name": "Input File", "sourceRepo": "Community", "pluginName": "inputFile", "version": "1.0.0", "fpEnabled": true, "position": { "x": 400, "y": 0 } },
    { "id": "dp-medium", "name": "Check File Medium", "sourceRepo": "Community", "pluginName": "checkFileMedium", "version": "1.0.0", "fpEnabled": true, "position": { "x": 400, "y": 100 } },
    { "id": "dp-start", "name": "Begin Command", "sourceRepo": "Community", "pluginName": "ffmpegCommandStart", "version": "1.0.0", "fpEnabled": true, "position": { "x": 400, "y": 200 } },
    {
      "id": "dp-policy",
      "name": "Direct-play policy",
      "sourceRepo": "Community",
      "pluginName": "customFunction",
      "version": "1.0.0",
      "fpEnabled": true,
      "position": { "x": 400, "y": 300 },
      "inputsDB": { "code": "__STREAM_POLICY__" }
    },
    {
      "id": "dp-enc-hw",
      "name": "HEVC Main10 (QSV decode)",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandSetVideoEncoder",
      "version": "1.0.0",
      "fpEnabled": true,
      "position": { "x": 100, "y": 420 },
      "inputsDB": {
        "outputCodec": "hevc",
        "ffmpegPresetEnabled": "true",
        "ffmpegPreset": "slow",
        "ffmpegQualityEnabled": "true",
        "ffmpegQuality": "23",
        "hardwareEncoding": "true",
        "hardwareType": "qsv",
        "hardwareDecoding": "true",
        "forceEncoding": "true"
      }
    },
    {
      "id": "dp-enc-sw",
      "name": "HEVC Main10 (CPU decode)",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandSetVideoEncoder",
      "version": "1.0.0",
      "fpEnabled": true,
      "position": { "x": 350, "y": 420 },
      "inputsDB": {
        "outputCodec": "hevc",
        "ffmpegPresetEnabled": "true",
        "ffmpegPreset": "slow",
        "ffmpegQualityEnabled": "true",
        "ffmpegQuality": "23",
        "hardwareEncoding": "true",
        "hardwareType": "qsv",
        "hardwareDecoding": "false",
        "forceEncoding": "true"
      }
    },
    {
      "id": "dp-enc-mkv",
      "name": "Set Container (encode)",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandSetContainer",
      "version": "1.0.0",
      "fpEnabled": true,
      "position": { "x": 225, "y": 520 },
      "inputsDB": { "container": "mkv", "forceConform": "false" }
    },
    { "id": "dp-enc-exec", "name": "Execute (encode)", "sourceRepo": "Community", "pluginName": "ffmpegCommandExecute", "version": "1.0.0", "fpEnabled": true, "position": { "x": 225, "y": 620 } },
    { "id": "dp-enc-stats", "name": "Refresh track stats (encode)", "sourceRepo": "Community", "pluginName": "runMkvPropEdit", "version": "1.0.0", "fpEnabled": true, "position": { "x": 225, "y": 720 } },
    {
      "id": "dp-enc-dur",
      "name": "Duration within 1.5% (encode)",
      "sourceRepo": "Community",
      "pluginName": "compareFileDurationRatio",
      "version": "1.0.0",
      "fpEnabled": true,
      "position": { "x": 225, "y": 820 },
      "inputsDB": { "greaterThan": "98.5", "lessThan": "101.5" }
    },
    {
      "id": "dp-enc-size",
      "name": "Size guard by encode reason",
      "sourceRepo": "Community",
      "pluginName": "customFunction",
      "version": "1.0.0",
      "fpEnabled": true,
      "position": { "x": 225, "y": 920 },
      "inputsDB": { "code": "__SIZE_GUARD__" }
    },
    {
      "id": "dp-rmx-mkv",
      "name": "Set Container (remux)",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandSetContainer",
      "version": "1.0.0",
      "fpEnabled": true,
      "position": { "x": 650, "y": 520 },
      "inputsDB": { "container": "mkv", "forceConform": "false" }
    },
    { "id": "dp-rmx-exec", "name": "Execute (remux)", "sourceRepo": "Community", "pluginName": "ffmpegCommandExecute", "version": "1.0.0", "fpEnabled": true, "position": { "x": 650, "y": 620 } },
    { "id": "dp-rmx-stats", "name": "Refresh track stats (remux)", "sourceRepo": "Community", "pluginName": "runMkvPropEdit", "version": "1.0.0", "fpEnabled": true, "position": { "x": 650, "y": 720 } },
    {
      "id": "dp-rmx-dur",
      "name": "Duration within 1.5% (remux)",
      "sourceRepo": "Community",
      "pluginName": "compareFileDurationRatio",
      "version": "1.0.0",
      "fpEnabled": true,
      "position": { "x": 650, "y": 820 },
      "inputsDB": { "greaterThan": "98.5", "lessThan": "101.5" }
    },
    {
      "id": "dp-rmx-size",
      "name": "Size sane (remux)",
      "sourceRepo": "Community",
      "pluginName": "compareFileSizeRatio",
      "version": "2.0.0",
      "fpEnabled": true,
      "position": { "x": 650, "y": 920 },
      "inputsDB": { "greaterThan": "30", "lessThan": "105" }
    },
    { "id": "dp-replace", "name": "Replace Original File", "sourceRepo": "Community", "pluginName": "replaceOriginalFile", "version": "1.0.0", "fpEnabled": true, "position": { "x": 400, "y": 1040 } },
    { "id": "dp-fail", "name": "Fail Flow (original kept)", "sourceRepo": "Community", "pluginName": "failFlow", "version": "1.0.0", "fpEnabled": true, "position": { "x": 900, "y": 920 } }
