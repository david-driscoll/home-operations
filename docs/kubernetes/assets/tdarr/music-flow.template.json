    { "id": "m-medium-start", "source": "mu-medium", "sourceHandle": "2", "target": "mu-start", "targetHandle": null },
    { "id": "m-start-policy", "source": "mu-start", "sourceHandle": "1", "target": "mu-policy", "targetHandle": null },
