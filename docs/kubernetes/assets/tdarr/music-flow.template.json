    { "id": "m-exec-dur", "source": "mu-exec", "sourceHandle": "1", "target": "mu-dur", "targetHandle": null },
    { "id": "m-dur-size", "source": "mu-dur", "sourceHandle": "1", "target": "mu-size", "targetHandle": null },
    { "id": "m-dur-fail-lo", "source": "mu-dur", "sourceHandle": "2", "target": "mu-fail", "targetHandle": null },
    { "id": "m-dur-fail-hi", "source": "mu-dur", "sourceHandle": "3", "target": "mu-fail", "targetHandle": null },
    { "id": "m-size-replace", "source": "mu-size", "sourceHandle": "1", "target": "mu-replace", "targetHandle": null },
    { "id": "m-size-fail-lo", "source": "mu-size", "sourceHandle": "2", "target": "mu-fail", "targetHandle": null },
    { "id": "m-size-fail-hi", "source": "mu-size", "sourceHandle": "3", "target": "mu-fail", "targetHandle": null }
