#!/usr/bin/env bash
#MISE description="Validate the rendered Talos machine configs, and that talosctl matches talenv.yaml"
#MISE dir="{{config_root}}/talos"
#MISE depends=["talos:genconfig"]
#
# The check that matters is talosctl PINNED IN .config/mise.toml against
# talenv.yaml's talosVersion. That is the drift that actually bites: bump
# talenv without bumping [tools] and you validate next release's config with
# last release's schema.
#
# Do NOT rewrite this to resolve talosctl as
# `mise exec talosctl@${expected} -- talosctl version` and compare to
# ${expected} — mise satisfies that by installing exactly the version asked
# for, so the comparison can never fail. That is a tautology, not a drift
# check, and it is what this task previously did.
# shellcheck disable=SC2016  # the backticks below are prose emphasis in an
#                            operator-facing message, not a command
#                            substitution -- the single quotes are intentional.
set -Eeuo pipefail

expected_talos_version="$(yq '.talosVersion' ./talenv.yaml)"
talosctl_version="$(talosctl version --client | awk '/Tag:/ {print $2}')"

if [[ "${talosctl_version}" != "${expected_talos_version}" ]]; then
  printf 'talos:validate-config: talosctl is %s but talos/talenv.yaml asks for %s.\n' \
    "${talosctl_version}" "${expected_talos_version}" >&2
  printf 'talos:validate-config: bump `talosctl` in .config/mise.toml [tools] to match, then `mise install`.\n' >&2
  exit 1
fi

shopt -s nullglob
configs=(./clusterconfig/*.yaml)
if ((${#configs[@]} == 0)); then
  # genconfig ran (it is a dependency) yet produced nothing — that is a
  # talconfig problem, not a missing-file problem, so say so rather than
  # reporting a vacuous pass.
  printf 'talos:validate-config: no ./clusterconfig/*.yaml after genconfig.\n' >&2
  exit 1
fi

# `--strict` turns deprecation warnings into a non-zero exit, which is what we
# want -- EXCEPT for one the repo cannot currently act on. Talos 1.14 deprecates
# `.machine.files`, but talhelper 3.1.17 (the newest release) will not render the
# `CRICustomizationConfig` that replaces it, so the warning is unavoidable until
# talhelper catches up. See talos/patches/global/machine-files.yaml.
#
# Tolerating it by EXACT TEXT rather than dropping `--strict` keeps the gate
# meaningful: a second, different deprecation still fails this task rather than
# hiding behind a blanket relaxation.
known_deprecation='.machine.files is deprecated'

failed=0
for cfg in "${configs[@]}"; do
  printf 'Validating %s\n' "${cfg}"
  if out="$(talosctl validate --mode metal --strict --config "${cfg}" 2>&1)"; then
    continue
  fi

  # Drop the known-and-accepted warning, then see whether anything substantive
  # is left. `grep -v` on the message alone would leave the multi-error wrapper
  # lines behind, so the residue is checked for real content: any line that
  # still mentions an error or a warning.
  # Strip the accepted warning, then the "N error(s) occurred:" wrapper lines
  # that multierror emits around it (they can be nested and prefixed, e.g.
  # "* v1alpha1.Config: 1 error occurred:"), then blank lines. Whatever is left
  # is a real finding.
  residue="$(printf '%s\n' "${out}" \
    | grep -v -F "${known_deprecation}" \
    | grep -viE '[0-9]+ errors? occurred:?[[:space:]]*$' \
    | grep -vE '^[[:space:]]*\*?[[:space:]]*$' || true)"

  if [[ -z "${residue}" ]]; then
    printf '  tolerated: %s (talhelper cannot emit CRICustomizationConfig yet)\n' "${known_deprecation}"
    continue
  fi

  printf 'talos:validate-config: %s failed validation:\n%s\n' "${cfg}" "${out}" >&2
  failed=1
done

if ((failed)); then
  exit 1
fi

printf 'Talos config validation passed.\n'
