#!/usr/bin/env bash
#MISE description="Render every node's Talos machine config into talos/clusterconfig with TOPF, plus an admin talosconfig"
#MISE dir="{{config_root}}/talos"
#
# Named `genconfig` for continuity: it was the talhelper subcommand this task
# wrapped, and every task that needs a rendered config or a working talosconfig
# still `depends` on it. TOPF does not need a render to apply -- `topf apply`
# renders for itself, against the Talos version each node RUNS -- so the files
# here are for reading and for `talos:validate-config`, not an apply input.
#
# This render is OFFLINE: the config version contract comes from topf.yaml's
# talosVersion. `talos:diff` shows what a node would actually receive.
#
# Outputs land in talos/clusterconfig/ (gitignored wholesale, see its
# .gitignore): <host>.yaml per node, and the generated `talosconfig` that
# $TALOSCONFIG points at. All of it is secret.
#
# Preconditions, inline: mise has no `preconditions:` mechanism. There is
# deliberately no `which topf / talosctl` check — both are pinned in
# .config/mise.toml [tools], so mise installs them before the task body runs.
set -Eeuo pipefail

# shellcheck source=scripts/lib/talos-topf.sh
source "${MISE_CONFIG_ROOT}/scripts/lib/talos-topf.sh"
topf_preflight

umask 077
# A node removed from topf.yaml would otherwise leave its last render behind
# for validate-config to keep checking.
find clusterconfig -maxdepth 1 -type f -name '*.yaml' -delete

# </dev/null: should TOPF ever prompt (it only does to generate a missing
# secrets bundle, which topf_preflight already rules out), a non-terminal
# stdin makes it decline instead of waiting.
topf render --output clusterconfig </dev/null

# A fresh os:admin client certificate on every run, signed by the bundle's
# Talos CA. Endpoints are the control planes, nodes are every node.
topf talosconfig </dev/null > clusterconfig/talosconfig
