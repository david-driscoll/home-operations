#!/usr/bin/env bash
#MISE description="Fetch the admin kubeconfig from Talos into the repo-local ./kubeconfig"
#MISE dir="{{config_root}}/talos"
#MISE depends=["talos:genconfig"]
#
# Ported from equestria-cluster/.taskfiles/bootstrap/Taskfile.yaml — the last
# line of `bootstrap:talos`:
#
#   until talhelper gencommand kubeconfig --extra-flags="{{.ROOT_DIR}} --force" | bash; do sleep 10; done
#
# Lifted out of bootstrap and given a task of its own because this repo needs it
# on its own terms: .config/mise.toml's $KUBECONFIG names
# ${MISE_CONFIG_ROOT}/kubeconfig as its FIRST entry, and nothing else in the repo
# ever creates that file. Without this task the repo-local half of that list is
# permanently absent (harmless, but also pointless).
#
# WHY IT `depends` ON genconfig, rather than shelling out to talosctl directly.
# The command talhelper emits is
#
#   talosctl kubeconfig --talosconfig=./clusterconfig/talosconfig <dir> --force --nodes=<cp-ip>
#
# so it reads talos/clusterconfig/talosconfig — which only `talos:genconfig`
# writes, and which talos/clusterconfig/.gitignore keeps out of the repo. On a
# fresh clone or a git worktree that file does not exist, and without the
# dependency this would fail with a talosconfig-not-found error instead of
# simply rendering the config it needs. Every other task in this namespace that
# touches the Talos API takes the same dependency for the same reason.
#
# Using talhelper rather than hand-rolling talosctl also means the control-plane
# node it talks to comes from talconfig.yaml, so it stays correct when nodes are
# added or renumbered.
#
# IDEMPOTENT. `--force` overwrites the destination instead of merging into it or
# refusing to touch an existing file, so re-running converges on the same
# kubeconfig rather than accumulating stale clusters/users. The generated
# context is `admin@equestria` pointing at talconfig.yaml's endpoint — the same
# name and the same server as the `admin@equestria` in a typical ~/.kube/config,
# which is why putting this file first in $KUBECONFIG is a no-op in practice.
#
# Safe to re-run at any time; it only READS from the Talos API.
set -Eeuo pipefail

# The source wrapped this in `until … ; do sleep 10; done` with no bound, which
# is right for a bootstrap that is waiting on a cluster that does not exist yet
# and wrong for a task you run by hand — an unreachable cluster would hang
# forever with no output. Bounded instead, at the same 10s cadence.
readonly max_attempts=30
readonly retry_seconds=10

for attempt in $(seq 1 "${max_attempts}"); do
  if talhelper gencommand kubeconfig --extra-flags="${MISE_CONFIG_ROOT} --force" | bash; then
    break
  fi

  if ((attempt == max_attempts)); then
    printf 'talos:kubeconfig: gave up after %d attempts (%ds).\n' \
      "${max_attempts}" "$((max_attempts * retry_seconds))" >&2
    printf 'talos:kubeconfig: the Talos API is not answering — check the nodes are up and that\n' >&2
    printf 'talos:kubeconfig: TALOSCONFIG (%s) is the admin one.\n' "${TALOSCONFIG}" >&2
    exit 1
  fi

  printf 'talos:kubeconfig: attempt %d/%d failed, retrying in %ds…\n' \
    "${attempt}" "${max_attempts}" "${retry_seconds}" >&2
  sleep "${retry_seconds}"
done

# talosctl exits 0 on some partial writes, so confirm rather than assume.
[[ -s "${MISE_CONFIG_ROOT}/kubeconfig" ]] || {
  printf 'talos:kubeconfig: talosctl reported success but %s/kubeconfig is missing or empty.\n' \
    "${MISE_CONFIG_ROOT}" >&2
  exit 1
}

printf 'Wrote %s/kubeconfig (context: %s)\n' \
  "${MISE_CONFIG_ROOT}" \
  "$(kubectl --kubeconfig "${MISE_CONFIG_ROOT}/kubeconfig" config current-context)"
