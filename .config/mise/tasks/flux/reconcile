#!/usr/bin/env bash
#MISE description="Force Flux to pull both GitRepositories and re-reconcile the root"
#
# Both sources named here exist in this repo's Flux tree:
#   flux-system     — kubernetes/flux/cluster/ks.yaml (the root, this repo)
#   home-operations — kubernetes/apps/flux-system/repositories/home-operations.yaml
#
# The `vault` GitRepository was removed when the vault repo was retired
# (2026-08-22); its contents live in this repo at the same relative paths.
#
# Follows the AMBIENT kubeconfig/context — this repo carries no kubeconfig and
# pins no KUBECONFIG, so check `kubectl config current-context` first.
set -Eeuo pipefail

flux --namespace flux-system reconcile source git flux-system
flux --namespace flux-system reconcile source git home-operations
flux --namespace flux-system reconcile kustomization flux-system --with-source
