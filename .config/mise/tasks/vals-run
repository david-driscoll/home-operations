#!/usr/bin/env bash
#MISE description="Resolve ref+ values in the environment with vals, then run the command (the `op run` replacement)"
#MISE dir="{{cwd}}"
#
# dir={{cwd}} because mise runs tasks from the CONFIG ROOT by default, and
# these commands are per-stack: without it `mise run vals-run pulumi preview`
# executes in the repo root and picks up the wrong Pulumi.yaml.
#
# vals-run — resolve every `ref+…` value in the environment, then exec.
#
#   mise run vals-run pulumi preview --stack home-operations
#   mise run vals-run kubectl get pods
#
# This replaces `op run`. `op run` substituted `op://` values it found in the
# environment; `vals exec` only resolves what is in its `-f` file, so this
# builds that file from the environment and hands it over. Same ergonomics,
# any backend vals supports — each value in .config/mise.toml names its own
# (`ref+openbao://`, `ref+sops://`, `ref+op://`, …).
#
# Resolution happens per command rather than in mise's `[env]` on purpose:
# mise re-evaluates env on EVERY load with no caching, so resolving there
# would hit OpenBao on every `cd` into the repo and break the shell whenever
# you are off-network or without an age key.
#
# The temp file holds REFERENCES, never resolved values — the secrets exist
# only in the environment vals hands to the child. It is a real file rather
# than a pipe because `-f /dev/stdin` leaves the child with a consumed stdin,
# which breaks anything interactive (a `pulumi up` confirmation).
#
# ## Two passes, because the credential is itself a reference
#
# .config/mise.toml sets BAO_ROLE_ID / BAO_SECRET_ID to `ref+sops://` values —
# the AppRole vals authenticates to OpenBao WITH. Resolving everything in one
# pass does not work: vals reads those variables straight out of the
# environment, finds the literal string "ref+sops://…", and every
# `ref+openbao://` value fails with a bare 403 that names no cause.
#
# So the bootstrap variables are split out and resolved first, by NESTING two
# `vals exec` calls rather than capturing anything:
#
#   vals exec -f bootstrap.yaml -- vals exec -f refs.yaml -- <command>
#
# The outer call puts the resolved AppRole in the inner call's environment,
# where its openbao provider picks it up. No secret is ever assigned to a shell
# variable or written to disk — which a `vals get` + `export` version could not
# claim.
set -Eeuo pipefail

[[ $# -gt 0 ]] || { printf 'usage: mise run vals-run <command> [args…]\n' >&2; exit 2; }

# A temp DIRECTORY, not `mktemp <tpl>.yaml`: BSD mktemp requires the X's at the
# end of the template, so a suffixed template fails on macOS — where this is
# mostly run. vals picks its parser from the extension, so the file needs one.
refsdir="$(mktemp -d "${TMPDIR:-/tmp}/vals-run.XXXXXX")"
refs="${refsdir}/refs.yaml"
bootstrap="${refsdir}/bootstrap.yaml"
trap 'rm -rf "${refsdir}"' EXIT

# The credentials vals (and `components/bao.ts`) authenticate WITH, which have
# to be resolved before anything that needs them. VAULT_* are here too because
# vals' vault provider reads those, and a repo that moves back to it should not
# rediscover this ordering from a 403.
is_bootstrap() {
  case "$1" in
    BAO_ROLE_ID | BAO_SECRET_ID | BAO_TOKEN | VAULT_ROLE_ID | VAULT_SECRET_ID | VAULT_TOKEN) return 0 ;;
    *) return 1 ;;
  esac
}

while IFS= read -r line; do
  name="${line%%=*}"
  value="${line#*=}"
  case "${value}" in
    ref+*) ;;
    *) continue ;;
  esac
  quoted="$(printf '%s' "${value}" | sed 's/"/\\"/g; s/^/"/; s/$/"/')"
  if is_bootstrap "${name}"; then
    case "${value}" in
      ref+openbao://* | ref+vault://*)
        # Nothing can break this cycle at runtime, so name it precisely rather
        # than letting it surface as a 403 from the store itself.
        printf 'vals-run: %s is an OpenBao/Vault reference, but it is the credential used to REACH OpenBao.\n' "${name}" >&2
        printf 'vals-run: point it at a backend that needs no OpenBao (ref+sops://, ref+file://).\n' >&2
        exit 2
        ;;
    esac
    printf '%s: %s\n' "${name}" "${quoted}" >> "${bootstrap}"
  else
    printf '%s: %s\n' "${name}" "${quoted}" >> "${refs}"
  fi
done < <(env)

if [[ ! -s "${refs}" && ! -s "${bootstrap}" ]]; then
  # Nothing to resolve is not an error, but say so: the alternative is a silent
  # run against unresolved config that fails much further along, somewhere that
  # does not mention secrets at all.
  printf 'vals-run: no ref+ values in the environment; running unchanged.\n' >&2
  exec "$@"
fi

# shellcheck disable=SC2016  # the backticks are prose emphasis in the message,
# not a command substitution -- the single quotes are intentional.
command -v vals >/dev/null || { printf 'vals-run: vals is not installed — `mise install` in this repo.\n' >&2; exit 127; }

# Resolving the bootstrap credential alone is still worth doing when nothing
# else references OpenBao: `pulumi` itself reads BAO_ROLE_ID/BAO_SECRET_ID
# (components/bao.ts), so this is what replaces `eval "$(pulumi-env.sh)"`.
if [[ -s "${bootstrap}" && -s "${refs}" ]]; then
  exec vals exec -i -f "${bootstrap}" -- vals exec -i -f "${refs}" -- "$@"
elif [[ -s "${bootstrap}" ]]; then
  exec vals exec -i -f "${bootstrap}" -- "$@"
else
  exec vals exec -i -f "${refs}" -- "$@"
fi
