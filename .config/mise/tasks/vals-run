#!/usr/bin/env bash
#MISE description="DEPRECATED alias for `fnox exec --`: run a command with the repo's secrets (.config/fnox.toml)"
#MISE dir="{{cwd}}"
#
# vals-run resolved the `ref+` values in .config/mise.toml's [env] with two
# nested `vals exec` calls. Those values now live in .config/fnox.toml and fnox
# resolves them, so this only forwards:
#
#   mise run vals-run pulumi preview   ==   fnox exec -- pulumi preview
#
# Kept so older notes, docs and muscle memory still work. Call fnox directly in
# anything new; this file can go once nothing says `vals-run` any more.
#
# dir={{cwd}} because mise runs tasks from the CONFIG ROOT by default, and
# these commands are per-stack: without it the command would run in the repo
# root and pick up the wrong Pulumi.yaml.
set -Eeuo pipefail

# Older docs wrote `mise run vals-run -- <command>`; mise passes that `--` through.
[[ "${1:-}" == "--" ]] && shift
[[ $# -gt 0 ]] || { printf 'usage: mise run vals-run <command> [args…]  (now: fnox exec -- <command>)\n' >&2; exit 2; }

# shellcheck disable=SC2016  # the backticks are prose, not a substitution.
printf 'vals-run: deprecated, running `fnox exec -- %s`\n' "$*" >&2
exec fnox exec -- "$@"
