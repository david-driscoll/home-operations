#!/usr/bin/env bash
#MISE description="Delete Failed and Succeeded pods across all namespaces"
#
# Failed and Succeeded ONLY — Pending is deliberately excluded. A Pending pod is
# one the scheduler has not placed yet; deleting those in bulk fights the
# scheduler rather than cleaning up after it.
#
# Follows the AMBIENT kubeconfig/context.
set -Eeuo pipefail

for phase in Failed Succeeded; do
  kubectl delete pods --field-selector "status.phase=${phase}" -A --ignore-not-found=true
done
