#!/usr/bin/env bash
#MISE description="Guard: fail by name when no kubeconfig context is resolvable"
#MISE hide=true
#
# Not ported from anywhere. It is the mise equivalent of the
# `preconditions: - test -f {{.KUBECONFIG}}` that every kubectl/flux task in
# equestria-cluster's Taskfile carried, and it is a `depends` of all eight
# migrated kubectl/flux tasks in this repo.
#
# WHAT IT DOES NOT CHECK, deliberately: the existence of
# ${MISE_CONFIG_ROOT}/kubeconfig. That is what the source's `test -f` did, and
# copying it here would be a regression rather than a guard. This repo's
# $KUBECONFIG is a two-entry LIST — the repo-local file first, then
# ~/.kube/config — and kubectl silently skips list entries that do not exist.
# Anyone driving these tasks from their own ~/.kube/config today is fully
# supported and must keep working, so the question worth asking is "is there a
# usable context at all", not "did you run talos:kubeconfig".
#
# `kubectl config current-context` answers exactly that, is local-only (no API
# call, so no timeout on a down cluster), and fails when every entry in
# $KUBECONFIG is missing — which is the case that otherwise surfaces as flux's
# opaque `dial tcp [::1]:8080: connect: connection refused`, kubectl's silent
# fallback to localhost:8080.
set -Eeuo pipefail

if kubectl config current-context >/dev/null 2>&1; then
  exit 0
fi

printf 'No kubeconfig context is set — every kubectl/flux task here would fall back to\n' >&2
printf 'localhost:8080 and fail with a connection-refused error that names nothing.\n\n' >&2
printf 'KUBECONFIG=%s\n\n' "${KUBECONFIG:-<unset>}" >&2
printf 'Fix it with either:\n' >&2
printf '  mise run talos:kubeconfig   # fetch the repo-local one from the Talos API\n' >&2
printf '  kubectl config use-context <name>   # if you already have one of your own\n' >&2
exit 1
