amends "package://github.com/jdx/hk/releases/download/v2.8.0/hk@2.8.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.8.0/hk@2.8.0#/Builtins.pkl"

// These two package URLs MUST move with `hk` in .config/mise.toml across a
// major version. Renovate bumps the binary but not these URLs: hk 2.0.1
// evaluating the v1.55.0 package fails every hook with
// `union property 'command' has no selected default`, which aborts every
// commit and push in the repo. (hk 1.58.1 does load the v2.0.1 package, so
// the URL can lead the binary, never trail it across a major.)

// hk hook configuration — consolidated from the two competing configs that
// both landed on main (root `hk.pkl` from #601, `.config/hk.pkl` from #603),
// then extended when this repo absorbed the Kubernetes tree.
//
// HOOK POSTURE
//
//   * pre-commit runs with `fix = true`: a step that has a fixer (biome,
//     pkl-format, trailing-whitespace, newlines) rewrites the staged files
//     and hk re-stages them, so a formatting slip is repaired in the commit
//     instead of failing it. Steps with no fixer still fail the commit. This
//     was `false` while every agent shared one checkout; sessions now work in
//     their own git worktree (see CLAUDE.md), so the files a commit touches
//     belong to the session making it.
//   * Two fixers are deliberately NOT allowed to run unattended -- see
//     `preCommitSteps` below: `typos` stays check-only on commit, and biome
//     applies only its safe fixes. `hk fix` still runs both in full.
//   * `stash = "none"` stays, on both hooks. Measured on hk 2.5.0 in a
//     throwaway repo: `"patch-file"` (like `"git"`) pushes a `git stash` for
//     the length of the hook, taking unstaged edits AND untracked files out
//     of the working tree, and a killed hook leaves them stranded there. The
//     stash stack is shared by every worktree of this repo, and hooks do get
//     killed here (a cold-cache `flate` can hang).
//     THE COST: fixers see the whole working-tree file, and hk re-stages the
//     whole file. If a file is only PARTLY staged (`git add -p`) and a fixer
//     changes it, its unstaged hunks are committed too. Files with nothing
//     staged are never touched. Use `HK_FIX=0 git commit` for a partial
//     commit, or `HK=0 git commit` to skip the hook.
//   * pre-push stays `fix = false`: a fix there would land after the commits
//     being pushed, as dirt.
//
// Crew's own hooks are NOT re-expressed here. hk registers via git config
// (`hook.hk-pre-commit.*`) and git 2.55 runs that channel *alongside*
// `.git/hooks/*`, so crew's state-sync hooks keep working untouched.
// See the PR body for why the crew state guard deliberately stays with crew.

// NB: this is `List(...)`, not `new Listing {...}`. hk's `exclude` is typed
// `String | List<String> | Regex`; a `Listing` is tolerated by hk's own loader
// but is a hard type error under plain `pkl eval`, which is what the `pkl`
// step below runs against this very file. Written as a Listing, this config
// fails its own linter.
local excludes =
  List(
    // SOPS-ENCRYPTED FILES — HIGHEST-SEVERITY EXCLUSION. DO NOT REMOVE.
    // Any byte-level rewrite (trailing whitespace, final newline, reformat, or a
    // `typos` spelling "correction" applied to base64 ciphertext) invalidates the
    // SOPS MAC and renders the file PERMANENTLY UNDECRYPTABLE.
    // The `trailing-whitespace` and `newlines` steps below were verified to
    // rewrite a `.sops.yaml` file under `hk fix --all` when NOT excluded here.
    // Note: a per-step `exclude` type-checks but does NOT actually filter in
    // hk 1.53–1.55 — the exclusion has to live at this top level to take effect.
    "**/*.sops.yaml",
    "**/*.sops.yml",
    "**/*.sops.json",
    "**/*.sops.env",
    "**/*.sops.toml",
    "**/*.agekey",
    "**/obj/**/*",
    "sdks/**/*",
    ".vs/**/*",
    ".vscode/**/*",
    "graphify-out/**/*",
    ".idea/**/*",
    ".claude/**/*",
    ".agents/**/*",
    ".apm/**/*",
    ".copilot/**/*",
    ".squad/**/*",
    // crew owns and rewrites everything under .crew/ — keep hk out of it,
    // otherwise the two tools fight over .crew/casting/*.json and .crew/templates/*.
    ".crew/**/*",
    // Documents secret *detection patterns*. Its reference table quotes the
    // PEM private-key banner verbatim as an example (no key body), which trips
    // the detect-private-key step and would fail every commit touching it.
    // Verified: this is the ONLY PEM banner in the repo outside the vendored
    // agent trees already excluded above.
    ".github/skills/secret-handling/SKILL.md",
    "**/*.verified.*",
    "**/*.received.*",
  )

local linters = new Mapping<String, Step> {
  // --- Flux manifests: the largest artifact class in the repo (~1070 YAML) ---

  // Renders every Kustomization and HelmRelease through the upstream helm,
  // kustomize and source SDKs and reports which ones fail to reconcile. This
  // is the check that catches a manifest Flux would reject BEFORE it reaches a
  // cluster; yamllint below only proves the file is well-formed YAML.
  //
  // Whole-repo, not per-file. The command deliberately contains no
  // `{{files}}`, so hk runs it exactly ONCE per hook no matter how many
  // manifests changed — `glob` here decides *whether* it runs, not what it
  // runs on. A render is only meaningful over the entire dependency graph
  // anyway: a one-line edit to a shared component changes what every consumer
  // renders to.
  //
  // `--path ./kubernetes/flux/cluster` is not optional. Without it flate walks
  // the whole repo and tries to parse every JSON/TS file it finds, emitting
  // `loader: file failed to parse` for each sdks/*/tsconfig.json. Scoped, the
  // run drops from ~5s to ~1.5s warm.
  //
  // `--allow-missing-secrets` is what lets this run off-cluster at all: the
  // ${VAR}s from cluster-secrets/shared-secrets render as placeholders. That
  // is also this step's blind spot — flate does NOT run Flux postBuild envsubst
  // or the external-secrets template engine, so it passes cleanly on a values
  // file that would take an app to zero pods.
  //
  // Cold cache: the first run pulls every Helm chart and OCI source over the
  // network and is far slower than the warm number above. `--source-retry-attempts 10`
  // absorbs transient registry flake. If you need to commit offline with a cold
  // cache, `HK=0 git commit` bypasses the hook entirely.
  ["flate"] = new Step {
    glob = List("kubernetes/**/*.yaml", "kubernetes/**/*.yml")
    check =
      "flate test all --path ./kubernetes/flux/cluster --allow-missing-secrets --source-retry-attempts 10 --no-progress"
  }

  // Closes the blind spot named in the `flate` comment directly above: this is
  // the step that DOES run Flux postBuild envsubst and the external-secrets
  // `templateAs: Values` template engine, over the files a kustomize
  // `configMapGenerator` slurps whole. The same binary runs as the
  // `eso-values-lint` job in .github/workflows/flux-local.yaml.
  //
  // Both renderers treat a *comment* as live text, so a `${VAR}` or `{{ ... }}`
  // inside one is executed -- twice the cause of a CrowdSec outage
  // (equestria-cluster#2977, #2980 / vault#111). It caught one live instance in
  // this repo on import, in the postgres values.yaml.
  //
  // `go -C` is required: the module is nested and there is no go.mod at the
  // repo root, so `go run ./scripts/...` cannot resolve it. Because `-C` also
  // changes the run'd program's working directory, the target path has to be
  // absolute.
  ["eso-values-lint"] = new Step {
    glob = List("kubernetes/**/*.yaml", "kubernetes/**/*.yml")
    check = "go -C scripts/eso-values-lint run . \"$(git rev-parse --show-toplevel)/kubernetes\""
  }

  // Configured by `.yamllint`, which disables the purely cosmetic rules and
  // keeps the ones that catch manifests Flux would silently mis-apply — above
  // all `key-duplicates`, where a repeated key in a HelmRelease drops the
  // earlier value with no error anywhere in the pipeline.
  ["yamllint"] = Builtins.yamllint

  // --- GitHub Actions ---
  // Shells out to shellcheck for `run:` blocks, which is the second reason
  // shellcheck is pinned in .config/mise.toml.
  ["actionlint"] = Builtins.actionlint

  // --- Shell ---
  // Configured by `.shellcheckrc`, which disables exactly three style codes,
  // each reviewed at every site. The error and warning tiers stay on.
  ["shellcheck"] = Builtins.shellcheck

  // --- TypeScript / JSON ---
  // Formatter + linter. Config lives in biome.json (which already excludes sdks/).
  ["biome"] = (Builtins.biome) {
    fix = "biome check --write --unsafe --no-errors-on-unmatched {{ files }}"
  }

  // --- Pkl ---
  // This file is the only .pkl in the repo, so these two steps exist to keep
  // *it* honest — nothing else was checking the thing that configures every
  // other check. `Builtins.pkl` runs `pkl eval`, which is stricter than hk's
  // own loader; see the note on `excludes` above for the trap that caught.
  ["pkl"] = Builtins.pkl
  ["pkl-format"] = Builtins.pkl_format

  // --- Spelling ---
  // Configured by `typos.toml`. Unconfigured this reports 256 findings, 249 of
  // them false — mostly SOPS ciphertext and product names (Mosquitto, HASS,
  // flate itself). The builtin passes `--force-exclude`, which is required for
  // typos.toml's excludes to apply to explicitly-named files rather than only
  // to directory walks.
  //
  // This step REWRITES file contents under `hk fix`. It is the reason
  // pre-commit overrides it to check-only (`preCommitSteps` below).
  ["typos"] = Builtins.typos

  // --- Whitespace hygiene ---
  // These DO rewrite files under a fix-enabled hook, which is why the sops
  // exclusions above are load-bearing.
  //
  // `trailing-whitespace` carries an explicit allowlist that OMITS Markdown.
  // Two trailing spaces are a MEANINGFUL hard line break in Markdown, and
  // stripping them silently joins paragraphs. This repo has ~1110 tracked .md
  // files, and the step ran unscoped here until now. pre-commit solves this
  // with `--markdown-linebreak-ext`; hk's builtin has no equivalent flag, and
  // neither a per-step `exclude` nor a `!` negation inside `glob` actually
  // filters (both type-check and are then ignored). A positive `glob`
  // allowlist is the only mechanism that works. Add extensions here as new
  // file types arrive.
  //
  // `newlines` is left global: appending a missing final newline is
  // semantically inert in every format here, Markdown included.
  ["trailing-whitespace"] = (Builtins.trailing_whitespace) {
    glob =
      List(
        "**/*.yaml",
        "**/*.yml",
        "**/*.json",
        "**/*.json5",
        "**/*.jsonl",
        "**/*.toml",
        "**/*.pkl",
        "**/*.sh",
        "**/*.bash",
        "**/*.ps1",
        "**/*.cs",
        "**/*.py",
        "**/*.js",
        "**/*.ts",
        "**/*.env",
        "**/*.txt",
      )
  }
  ["newlines"] = Builtins.newlines

  // --- Repo-hygiene guards. These are pure checks — they never rewrite a file. ---

  // The estate's root domain and tailnet name must not appear in plaintext in
  // any tracked file: the repo is public and its history is being scrubbed of
  // both (docs/plans/private-domain-scrub.md). The script reads the two names
  // from SOPS at run time and prints only paths and line numbers; files still
  // waiting on a later phase are listed in .config/private-domain-baseline.
  //
  // Whole-repo, like `flate`: no `{{files}}`, and it scans every tracked file
  // itself -- INCLUDING the .claude/, .apm/, .crew/ and .vscode/ trees the
  // top-level `exclude` hides from every other step, because agent skills and
  // memory-adjacent docs are exactly where the names get re-added. The flip
  // side of that exclude: a commit touching ONLY those trees does not trigger
  // this step, which is why .claude/hooks/private-domain-guard.sh also checks
  // every Write/Edit an agent makes. Without the age key it skips with a
  // warning -- there is nothing to compare against.
  ["private-domains"] = new Step {
    glob = List("**/*")
    check = "scripts/private-domain-guard check --cached"
  }

  ["check-merge-conflict"] = Builtins.check_merge_conflict
  ["detect-private-key"] = Builtins.detect_private_key
  ["check-added-large-files"] = Builtins.check_added_large_files
  // macOS checkouts are case-insensitive; Linux CI runners are not. This
  // catches the pair of files that collide only on the developer's machine.
  ["check-case-conflict"] = Builtins.check_case_conflict
  // Added with hk 2.0. Both are `hk util` subcommands, so they need no extra
  // pin in .config/mise.toml, and both are pure reads.
  //
  // `destroyed-symlinks` catches a tracked symlink that has been turned into
  // a regular file holding its target path. That is what a checkout on a
  // filesystem or tool that does not keep symlinks leaves behind (Windows
  // without core.symlinks, some sync/copy tools), and committing it quietly
  // breaks every consumer of the link.
  ["destroyed-symlinks"] = Builtins.destroyed_symlinks
  // The repo has no submodules and every tool here (Flux, flate, Renovate,
  // worktrees on a shared PVC) assumes a single tree. A stray gitlink from
  // `git add` over a nested clone would otherwise commit silently.
  ["forbid-submodules"] = Builtins.forbid_submodules
  // Deliberately NOT enabled: `check_executables_have_shebangs` and
  // `check_shebang_scripts_are_executable`. On 2026-09-23 they reported ~45
  // existing files -- mostly ConfigMap-mounted scripts and .dib/.cs files
  // that are correctly non-executable, and YAML committed with +x. Enabling
  // them needs a cleanup pass (or step excludes) first.
}

exclude = excludes

// Load-bearing for `fix = true` on pre-commit. After a fixer rewrites a file,
// hk re-stages it with `git add` while a `git status` of its own is still
// running. `git status` normally takes index.lock to write back the refreshed
// index, so in this repo the `git add` lost that race EVERY time (4 of 4
// runs): the commit failed with `Unable to create ... index.lock: File
// exists` and the lock was left behind, blocking all further git commands in
// the worktree until removed by hand. With optional locks off, `git status`
// reads without locking and the race is gone (4 of 4 clean). A tiny repo does
// not show this -- its status finishes before the add starts.
env {
  ["GIT_OPTIONAL_LOCKS"] = "0"
}

// The ONE deliberate exception to the no-mutation posture above, and only in
// pre-commit: keep graphify-out/ current IN the commit being made. See
// .config/hooks/graphify-precommit.sh for why this replaced graphify's own
// detached post-commit/post-checkout rebuilds (their output could only ever
// land after the commit, as dirt). It writes and stages ONLY graphify-out/,
// which is generated and never hand-edited, so it cannot sweep up a
// neighbour's edits; it acts only on `main` (branches never touch the ~25 MiB
// graph.json, so parallel PRs cannot conflict on it); and it fails open.
//
// `exclusive` because it writes the Git index itself: it is a `check`
// command, and hk stages only what a step's `fix` command changed. Listed
// last, so under hk's default fail-fast a failing linter cancels it before it
// runs. Not in `check`/`fix`/pre-push.
local graphifyStep = new Step {
  exclusive = true
  check = ".config/hooks/graphify-precommit.sh"
}

// What pre-commit runs: every linter, with two fixers reined in because
// nobody reads the diff a commit hook makes.
//
//   * `typos` -- check-only. Its fixer rewrites any word it has exactly one
//     suggestion for, and in a manifest that word can be a hostname, an image
//     name or a key. A wrong "correction" would be committed silently, so a
//     spelling finding still fails the commit: fix it, or teach typos.toml.
//   * `biome` -- without `--unsafe`. Unsafe fixes may change what the code
//     does; whatever they would have fixed fails the commit instead.
local preCommitSteps = (linters) {
  // All three lines are needed (each verified). With only `fix` cleared, hk
  // applies the patch that `check_diff` prints and the typo is still
  // rewritten. With `check_diff` cleared too, the builtin has no command left
  // and the step silently passes -- hence the explicit `check`.
  ["typos"] {
    fix = null
    check_diff = null
    check = "typos --force-exclude {{ files }}"
  }
  ["biome"] {
    fix = "biome check --write --no-errors-on-unmatched {{ files }}"
  }
  ["graphify"] = graphifyStep
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "none"
    steps = preCommitSteps
  }

  ["pre-push"] {
    fix = false
    stash = "none"
    steps = linters
  }

  // `hk check` — read-only, used by CI and by hand.
  ["check"] {
    steps = linters
  }

  // `hk fix` — explicit, human-invoked auto-fix.
  ["fix"] {
    fix = true
    steps = linters
  }
}
