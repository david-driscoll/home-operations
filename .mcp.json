{
  "mcpServers": {
    "kubernetes": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "kubernetes-mcp-server"]
    },
    "pulumi": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@pulumi/mcp-server", "stdio"]
    },
    "HA": {
      "type": "http",
      "url": "https://home.driscoll.tech/api/mcp",
      "oauth": {
        "clientId": "http://localhost:12345",
        "callbackPort": 12345
      }
    },
    "agent-tools": {
      "type": "http",
      "url": "https://agent-tools-mcp.agents.driscoll.tech/mcp"
    },
    "crew_state": {
      "command": "crew",
      "args": ["state-mcp"],
      "env": {},
      "tools": ["*"]
    },
    "mise": {
      "args": ["mcp"],
      "command": "mise",
      "env": {
        "MISE_EXPERIMENTAL": "1"
      },
      "type": "stdio"
    }
  }
}
