{
  "mcpServers": {
    "kubernetes": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "kubernetes-mcp-server"]
    },
    "pulumi": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@pulumi/mcp-server", "stdio"]
    },
    "HA": {
      "type": "http",
      "url": "https://home.driscoll.tech/api/mcp",
      "oauth": {
        "clientId": "http://localhost:12345",
        "callbackPort": 12345
      }
    },
    "agent-tools": {
      "type": "http",
      "url": "${AGENT_TOOLS_MCP_URL:-https://agent-tools-mcp.agents.driscoll.tech/mcp}"
    },
    "toolport-infrastructure": {
      "type": "http",
      "url": "${TOOLPORT_URL:-http://toolport.agents.svc.cluster.local:8765/mcp}",
      "headers": {
        "Authorization": "Bearer ${TOOLPORT_TOKEN_INFRASTRUCTURE:-}"
      }
    },
    "toolport-networking": {
      "type": "http",
      "url": "${TOOLPORT_URL:-http://toolport.agents.svc.cluster.local:8765/mcp}",
      "headers": {
        "Authorization": "Bearer ${TOOLPORT_TOKEN_NETWORKING:-}"
      }
    },
    "toolport-home": {
      "type": "http",
      "url": "${TOOLPORT_URL:-http://toolport.agents.svc.cluster.local:8765/mcp}",
      "headers": {
        "Authorization": "Bearer ${TOOLPORT_TOKEN_HOME:-}"
      }
    },
    "toolport-media": {
      "type": "http",
      "url": "${TOOLPORT_URL:-http://toolport.agents.svc.cluster.local:8765/mcp}",
      "headers": {
        "Authorization": "Bearer ${TOOLPORT_TOKEN_MEDIA:-}"
      }
    },
    "toolport-postgres": {
      "type": "http",
      "url": "${TOOLPORT_URL:-http://toolport.agents.svc.cluster.local:8765/mcp}",
      "headers": {
        "Authorization": "Bearer ${TOOLPORT_TOKEN_POSTGRES:-}"
      }
    },
    "toolport-research": {
      "type": "http",
      "url": "${TOOLPORT_URL:-http://toolport.agents.svc.cluster.local:8765/mcp}",
      "headers": {
        "Authorization": "Bearer ${TOOLPORT_TOKEN_RESEARCH:-}"
      }
    },
    "crew_state": {
      "command": "crew",
      "args": ["state-mcp"],
      "env": {},
      "tools": ["*"]
    },
    "mise": {
      "args": ["mcp"],
      "command": "mise",
      "env": {
        "MISE_EXPERIMENTAL": "1"
      },
      "type": "stdio"
    }
  }
}
