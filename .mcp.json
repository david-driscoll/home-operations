{
  "mcpServers": {
    "toolport-infrastructure": {
      "type": "http",
      "url": "${TOOLPORT_INFRASTRUCTURE_URL}"
    },
    "toolport-networking": {
      "type": "http",
      "url": "${TOOLPORT_NETWORKING_URL}"
    },
    "toolport-home": {
      "type": "http",
      "url": "${TOOLPORT_HOME_URL}"
    },
    "toolport-media": {
      "type": "http",
      "url": "${TOOLPORT_MEDIA_URL}"
    },
    "toolport-postgres": {
      "type": "http",
      "url": "${TOOLPORT_POSTGRES_URL}"
    },
    "toolport-research": {
      "type": "http",
      "url": "${TOOLPORT_RESEARCH_URL}"
    },
    "mise": {
      "args": ["mcp"],
      "command": "mise",
      "env": {
        "MISE_EXPERIMENTAL": "1"
      },
      "type": "stdio"
    }
  }
}
