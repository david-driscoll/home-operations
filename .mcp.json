{
  "mcpServers": {
    "agent-tools": {
      "type": "http",
      "url": "${AGENT_TOOLS_MCP_URL:-https://agent-tools-mcp.agents.driscoll.tech/mcp}"
    },
    "toolport-infrastructure": {
      "type": "http",
      "url": "${TOOLPORT_URL:-https://toolport.agents.driscoll.tech/mcp}",
      "headers": {
        "Authorization": "Bearer ${TOOLPORT_TOKEN_INFRASTRUCTURE:-}"
      }
    },
    "toolport-networking": {
      "type": "http",
      "url": "${TOOLPORT_URL:-https://toolport.agents.driscoll.tech/mcp}",
      "headers": {
        "Authorization": "Bearer ${TOOLPORT_TOKEN_NETWORKING:-}"
      }
    },
    "toolport-home": {
      "type": "http",
      "url": "${TOOLPORT_URL:-https://toolport.agents.driscoll.tech/mcp}",
      "headers": {
        "Authorization": "Bearer ${TOOLPORT_TOKEN_HOME:-}"
      }
    },
    "toolport-media": {
      "type": "http",
      "url": "${TOOLPORT_URL:-https://toolport.agents.driscoll.tech/mcp}",
      "headers": {
        "Authorization": "Bearer ${TOOLPORT_TOKEN_MEDIA:-}"
      }
    },
    "toolport-postgres": {
      "type": "http",
      "url": "${TOOLPORT_URL:-https://toolport.agents.driscoll.tech/mcp}",
      "headers": {
        "Authorization": "Bearer ${TOOLPORT_TOKEN_POSTGRES:-}"
      }
    },
    "toolport-research": {
      "type": "http",
      "url": "${TOOLPORT_URL:-https://toolport.agents.driscoll.tech/mcp}",
      "headers": {
        "Authorization": "Bearer ${TOOLPORT_TOKEN_RESEARCH:-}"
      }
    },
    "mise": {
      "args": ["mcp"],
      "command": "mise",
      "env": {
        "MISE_EXPERIMENTAL": "1"
      },
      "type": "stdio"
    }
  }
}
