{
  "mcpServers": {
    "toolport-infrastructure": {
      "type": "http",
      "url": "${TOOLPORT_INFRASTRUCTURE_URL}"
    },
    "toolport-networking": {
      "type": "http",
      "url": "${TOOLPORT_NETWORKING_URL}"
    },
    "toolport-home": {
      "type": "http",
      "url": "${TOOLPORT_HOME_URL}"
    },
    "toolport-media": {
      "type": "http",
      "url": "${TOOLPORT_MEDIA_URL}"
    },
    "toolport-postgres": {
      "type": "http",
      "url": "${TOOLPORT_POSTGRES_URL}"
    },
    "toolport-research": {
      "type": "http",
      "url": "${TOOLPORT_RESEARCH_URL}"
    },
    "mise": {
      "args": ["mcp"],
      "command": "mise",
      "env": {
        "MISE_EXPERIMENTAL": "1"
      },
      "type": "stdio"
    },
    "kubernetes": {
      "type": "local",
      "command": "npx",
      "args": ["-y", "kubernetes-mcp-server"],
      "tools": ["*"]
    },
    "pulumi": {
      "type": "local",
      "command": "npx",
      "args": ["-y", "@pulumi/mcp-server", "stdio"],
      "tools": ["*"]
    },
    "unifi-access": {
      "type": "local",
      "command": "op",
      "args": ["run", "--", "uvx", "unifi-access-mcp"],
      "tools": ["*"],
      "env": {
        "UNIFI_ACCESS_HOST": "discord.${ROOT_DOMAIN}",
        "UNIFI_ACCESS_PORT": "443",
        "UNIFI_ACCESS_VERIFY_SSL": "false",
        "UNIFI_ACCESS_USERNAME": "op://Eris/unifipoller/username",
        "UNIFI_ACCESS_PASSWORD": "op://Eris/unifipoller/password"
      }
    },
    "unifi-network": {
      "type": "local",
      "command": "op",
      "args": ["run", "--", "uvx", "unifi-network-mcp"],
      "tools": ["*"],
      "env": {
        "UNIFI_NETWORK_HOST": "discord.${ROOT_DOMAIN}",
        "UNIFI_NETWORK_PORT": "443",
        "UNIFI_NETWORK_SITE": "default",
        "UNIFI_NETWORK_VERIFY_SSL": "false",
        "UNIFI_NETWORK_USERNAME": "op://Eris/unifipoller/username",
        "UNIFI_NETWORK_PASSWORD": "op://Eris/unifipoller/password"
      }
    },
    "unifi-protect": {
      "type": "local",
      "command": "op",
      "args": ["run", "--", "uvx", "unifi-protect-mcp"],
      "tools": ["*"],
      "env": {
        "UNIFI_PROTECT_HOST": "discord.${ROOT_DOMAIN}",
        "UNIFI_PROTECT_PORT": "443",
        "UNIFI_PROTECT_VERIFY_SSL": "false",
        "UNIFI_PROTECT_USERNAME": "op://Eris/unifipoller/username",
        "UNIFI_PROTECT_PASSWORD": "op://Eris/unifipoller/password"
      }
    }
  }
}
