{
  "mcpServers": {
    "agent-tools": {
      "type": "http",
      "url": "${AGENT_TOOLS_MCP_URL:-https://agent-tools-mcp.agents.driscoll.tech/mcp}"
    },
    "toolport-infrastructure": {
      "type": "http",
      "url": "${TOOLPORT_INFRASTRUCTURE_URL:-https://toolport-infrastructure.agents.driscoll.tech/mcp}"
    },
    "toolport-networking": {
      "type": "http",
      "url": "${TOOLPORT_NETWORKING_URL:-https://toolport-networking.agents.driscoll.tech/mcp}"
    },
    "toolport-home": {
      "type": "http",
      "url": "${TOOLPORT_HOME_URL:-https://toolport-home.agents.driscoll.tech/mcp}"
    },
    "toolport-media": {
      "type": "http",
      "url": "${TOOLPORT_MEDIA_URL:-https://toolport-media.agents.driscoll.tech/mcp}"
    },
    "toolport-postgres": {
      "type": "http",
      "url": "${TOOLPORT_POSTGRES_URL:-https://toolport-postgres.agents.driscoll.tech/mcp}"
    },
    "toolport-research": {
      "type": "http",
      "url": "${TOOLPORT_RESEARCH_URL:-https://toolport-research.agents.driscoll.tech/mcp}"
    },
    "mise": {
      "args": ["mcp"],
      "command": "mise",
      "env": {
        "MISE_EXPERIMENTAL": "1"
      },
      "type": "stdio"
    }
  }
}
