{
  "compilerOptions": {
    "strict": true,
    "rootDir": "../..",
    "outDir": "../../bin",
    "allowImportingTsExtensions": true,
    // Node runs these files by stripping types (no tsx): only erasable
    // syntax, and type-only imports spelled `import type`.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "sourceMap": true,
    "experimentalDecorators": true,
    "pretty": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    // Type-only: every @openapi import is `import type` from a .d.ts, erased
    // before Node resolves anything. components/ and dynamic/ are imported by
    // their npm-workspace names (`components/x.ts`), which Node resolves itself.
    "paths": {
      "@openapi/*": ["../../types/*"]
    }
  },
  "include": ["./*.ts", "../../components/**/*.ts", "../../dynamic/**/*.ts", "../../types/**/*.ts", "../home/jobs.ts", "../home/backup-jobs.ts"]
}
