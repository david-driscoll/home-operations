NB_LISTEN_ADDRESS=":443"
# What the relay tells peers to dial. The public port, which the forward maps
# onto this host's 33443; components/netbird/server.ts lists the same address.
NB_EXPOSED_ADDRESS="rels://relay-home.${searchDomain}:443"
# The secret every relay shares with management, written by stacks/netbird-edge.
NB_AUTH_SECRET="ref+openbao://secrets/apps/netbird/server#/relayAuthSecret"
NB_LETSENCRYPT_DOMAINS="relay-home.${searchDomain}"
NB_LETSENCRYPT_DATA_DIR="/var/lib/netbird-relay"
NB_HEALTH_LISTEN_ADDRESS=":9000"
NB_LOG_LEVEL="info"
