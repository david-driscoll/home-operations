# authentik-pg-standby — alpha-site.
#
# The resolver expands references ANYWHERE in this file, comments included, and
# a reference to a missing item aborts the whole stacks/home run (HO#636). Never
# write a reference-shaped string in a comment here.

# authentik-pg-lan, the LAN LoadBalancer on the primary. An address rather than a
# name: the standby must keep its configuration when equestria's DNS is gone.
PRIMARY_HOST=10.10.206.150

# The replication role, minted by stacks/system (authentik-pg.ts) and managed on
# the primary by CNPG. pg_hba on the primary admits it only from 10.10.10.9.
REPLICATION_USER="ref+openbao://secrets/clusters/equestria/apps/authentik-pg/replication#/username"
REPLICATION_PASSWORD="ref+openbao://secrets/clusters/equestria/apps/authentik-pg/replication#/password"
