# Authentik — alpha-site.
#
# Every value here is a literal or a reference resolved at deploy time by the
# secret resolver (components/store/index.ts). That resolver is a plain regex
# over the raw file text with NO notion of comments, and a reference to a missing
# item throws an unhandled exception that aborts the entire stacks/home program,
# not just this stack (HO#636). So: never write a reference-shaped string in a
# comment here, even a disabled one, and never reference an item before it
# exists. The .ignore in this directory gates the stack until the one new item
# below has been created — see it for the checklist.

TZ=${TIMEZONE}

# --- secrets that ALREADY EXIST ---------------------------------------------
# These three are live today: SGC's ExternalSecrets read the same paths, and
# .config/mise.toml reads authentik-token for the Pulumi provider. Referencing
# them is safe now. Field names match what SGC's externalsecret.yaml extracts.
#
# SECRET_KEY signs sessions and encrypts secrets at rest. It MUST be the same
# value the SGC copy uses — the database restored in cutover step 3 is encrypted
# with it, and a fresh key silently invalidates every stored secret rather than
# failing loudly.
AUTHENTIK_SECRET_KEY="ref+openbao://secrets/clusters/alpha-site/apps/authentik/secret-key#/credential"

# Bootstrap identity. Applied on first boot against an empty database and
# ignored thereafter, so these stay correct across the later restore.
AUTHENTIK_BOOTSTRAP_TOKEN="ref+openbao://secrets/clusters/alpha-site/apps/authentik/token#/credential"
AUTHENTIK_BOOTSTRAP_PASSWORD="ref+openbao://secrets/clusters/alpha-site/apps/authentik/admin#/password"
AUTHENTIK_BOOTSTRAP_EMAIL="ref+openbao://secrets/clusters/alpha-site/apps/authentik/admin#/username"

# --- database — shared per-node postgres (docker/_common/postgres) ----------
# The role and database are provisioned by PGAPP_AUTHENTIK_PASSWORD in
# docker/alpha-site/postgres/.env-local, which the .ignore checklist adds at
# unlock time. Both sides reference the SAME field, so they cannot drift.
#
# Cross-stack, so no depends_on is possible: on a cold host boot these
# containers may crash-loop for a few cycles until postgres is up, and
# `restart: unless-stopped` converges it.
#
# This instance has no WAL archiving and will have none — the pg_dump ->
# backrest -> PBS chain is the only rollback path, and rollback granularity is
# the dump interval (section 3.2).
AUTHENTIK_POSTGRESQL__HOST=postgres
AUTHENTIK_POSTGRESQL__PORT=5432
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER="ref+openbao://secrets/clusters/alpha-site/apps/authentik/postgres#/username"
AUTHENTIK_POSTGRESQL__PASSWORD="ref+openbao://secrets/clusters/alpha-site/apps/authentik/postgres#/password"
AUTHENTIK_POSTGRESQL__CONN_HEALTH_CHECKS=true

# --- redis — bundled, see compose.yaml -------------------------------------
# DB 0, not 5: in-cluster authentik shares a valkey with other consumers and
# takes index 5. This instance has exactly one consumer.
AUTHENTIK_REDIS__HOST=authentik-redis
AUTHENTIK_REDIS__PORT=6379
AUTHENTIK_REDIS__DB=0

# --- behaviour — mirrors SGC's ExternalSecret template exactly ---------------
# Kept byte-identical so the move changes WHERE authentik runs and nothing about
# HOW it behaves. Any divergence here becomes a difference the cutover has to
# explain.
AUTHENTIK_STORAGE__MEDIA__BACKEND=file
AUTHENTIK_DISABLE_UPDATE_CHECK=true
AUTHENTIK_DISABLE_STARTUP_ANALYTICS=false
AUTHENTIK_AVATARS=gravatar
AUTHENTIK_DEFAULT_USER_CHANGE_NAME=true
AUTHENTIK_DEFAULT_USER_CHANGE_EMAIL=true
AUTHENTIK_DEFAULT_USER_CHANGE_USERNAME=true
AUTHENTIK_GDPR_COMPLIANCE=true
AUTHENTIK_DEFAULT_TOKEN_DURATION=minutes=60
AUTHENTIK_DEFAULT_TOKEN_LENGTH=128
AUTHENTIK_ERROR_REPORTING__ENABLED=false
AUTHENTIK_ERROR_REPORTING__SEND_PII=false
AUTHENTIK_ERROR_REPORTING__ENVIRONMENT=${CLUSTER_KEY}
# INFO here, not the `trace` the HelmRelease carries. trace on a Pi with a USB
# SSD is a write amplifier on the one disk the database also lives on.
AUTHENTIK_LOG_LEVEL=info
