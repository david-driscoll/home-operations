# Secret references here use the OpenBao vals scheme and are resolved by
# SecretRefResolver (components/store/refs.ts) before this file is copied to
# the host. vals has NO notion of comments -- never write a reference-shaped
# string in a comment here, even a disabled one. A reference to a missing path
# fails the entire alpha-site run loudly, which is the intended failure mode.
#
# --- this node's identity ----------------------------------------------------
# All three paths are minted BEFORE the first deploy (docs/garage-offsite-s3.md,
# "Pulumi state"). None is shared with the main cluster: a separate rpc secret
# is what keeps this node out of it.
GARAGE_RPC_SECRET="ref+openbao://secrets/docker/apps/garage-backup/rpc-secret#/password"
GARAGE_ADMIN_TOKEN="ref+openbao://secrets/docker/apps/garage-backup/admin-token#/password"

# --- the backup key on THIS node ---------------------------------------------
# Pre-minted key material (a GK-prefixed id and a 64-hex secret) that backup.sh
# IMPORTS into this node on first start. Minting it up front, rather than
# asking the node to create one, is what lets it be a plain reference here: a
# key the node generated could not exist in OpenBao before the node does.
BACKUP_DEST_ACCESS_KEY_ID="ref+openbao://secrets/docker/apps/garage-backup/backup-key#/username"
BACKUP_DEST_SECRET_ACCESS_KEY="ref+openbao://secrets/docker/apps/garage-backup/backup-key#/password"

# --- the source: the main cluster's pulumi-state bucket, READ-ONLY -----------
BACKUP_SOURCE_ACCESS_KEY_ID="ref+openbao://secrets/apps/pulumi/state-s3-reader#/username"
BACKUP_SOURCE_SECRET_ACCESS_KEY="ref+openbao://secrets/apps/pulumi/state-s3-reader#/password"

TIMEZONE=${TIMEZONE}

# Hourly mirror of the current checkpoints; one dated snapshot per UTC day,
# kept for 30 days.
BACKUP_MIRROR_INTERVAL_SECONDS=3600
BACKUP_SNAPSHOT_RETENTION_DAYS=30

# Gatus external-endpoint contract: the token must equal
# toGatusKey("Pulumi State Offsite Backup", <dockge name>) from
# stacks/backups/index.ts, and DOCKGE_NAME -- written without its sigils here,
# because a comment is substituted exactly like a value is -- is the token that
# yields that same identity.
BACKUP_UPTIME_URL=$UPTIME_API_URL
BACKUP_UPTIME_TOKEN=pulumi-state-offsite-backup_${DOCKGE_NAME}
