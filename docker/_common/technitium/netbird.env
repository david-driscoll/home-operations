# The NetBird sidecar's environment (compose.yaml's `netbird` service). Its own
# file, not .env: tailscale and technitium read .env, so a change here would
# recreate them, and recreating tailscale takes this host's DNS with it.
NB_MANAGEMENT_URL="https://netbird.${searchDomain}"
# stacks/netbird's `dns-servers` key (group dns-servers, reusable, never
# expires). Only the first start enrols with it; the peer is kept on the state
# volume after that.
NB_SETUP_KEY="ref+openbao://secrets/third-party-tokens/netbird/setup-keys#/dns"
NB_HOSTNAME="dns-${CLUSTER_KEY}"
# Technitium owns :53 in this network namespace; NetBird's resolver would
# collide with it. Clients get Technitium as their nameserver from management.
NB_DISABLE_DNS="true"
# NB_DISABLE_DNS alone does not keep NetBird off :53: its own resolver still
# binds <wt0 address>:53, which cost the Equestria Technitium its IPv4 :53
# socket on 2026-11-05 (kubernetes/apps/equestria/dns/technitium). Park it on
# loopback instead.
NB_DNS_RESOLVER_ADDRESS="127.0.0.1:5053"
# A nameserver, not a client: it reaches everything it needs without NetBird's routes.
NB_DISABLE_CLIENT_ROUTES="true"
# Fixed and clear of Tailscale's 41641 here and of the host gateway's 51820.
# Matches the Equestria sidecar (kubernetes/apps/equestria/dns/technitium).
NB_WIREGUARD_PORT="51821"
NB_LOG_LEVEL="info"
NB_LOG_FILE="console"
