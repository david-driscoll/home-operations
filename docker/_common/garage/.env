# Secret references here use the OpenBao vals scheme and are resolved by
# SecretRefResolver (components/store/refs.ts) before this file is copied to
# the host. vals has NO notion of comments — never write a reference-shaped
# string in a comment here, even a disabled one; spell the scheme broken apart
# instead. A reference to a missing path fails the entire run loudly, which is
# the intended failure mode.
#
# --- cluster identity -------------------------------------------------------
# Items to create BEFORE the first deploy of this stack (the bootstrap
# ceremony in docs/garage-offsite-s3.md; record both in bootstrap/INVENTORY.md):
#
#   bao kv put secrets/docker/apps/garage/rpc-secret  password="$(openssl rand -hex 32)"
#   bao kv put secrets/docker/apps/garage/admin-token password="$(openssl rand -hex 32)"
#
# One rpc secret for the whole mesh — it IS the cluster membership credential,
# shared by all three nodes by definition. Losing it does not lose data, but a
# node restarted without it can no longer join its own cluster. The admin
# token is what stacks/garage authenticates with; rotating it is a kv put plus
# a stack redeploy on every node.
GARAGE_RPC_SECRET="ref+openbao://secrets/docker/apps/garage/rpc-secret#/password"
GARAGE_ADMIN_TOKEN="ref+openbao://secrets/docker/apps/garage/admin-token#/password"

TIMEZONE=${TIMEZONE}

# --- dump mirror ------------------------------------------------------------
# Consumed by sync.sh. Six-hourly: the dumps only change once a day, but a
# cheap size/modtime pass every six hours bounds how stale a red heartbeat can
# be without waiting a whole day to notice. The S3 credential is deliberately
# NOT here — see the garage-sync service comment in compose.yaml.
GARAGE_SYNC_INTERVAL_SECONDS=21600
GARAGE_SYNC_BUCKET=postgres-${CLUSTER_KEY}

# Same Gatus external-endpoint contract as the postgres dump loop: the token
# must equal toGatusKey("Dockge Garage Postgres Sync", <dockge name>) from
# stacks/backups/index.ts, and DOCKGE_NAME — written without its sigils here,
# because a comment is substituted exactly like a value is — is the token that
# yields that same identity. The "dockge-garage-postgres-sync_" prefix restates
# toGatusKey's group half.
GARAGE_SYNC_UPTIME_URL=$UPTIME_API_URL
GARAGE_SYNC_UPTIME_TOKEN=dockge-garage-postgres-sync_${DOCKGE_NAME}

# --- in-cluster garage mirror ----------------------------------------------
# Consumed by mirror.sh, which is live only on the node holding
# /opt/stacks-data/garage/mirror.env (celestia; see the garage-mirror service
# comment in compose.yaml). Token contract as above, group
# "Dockge Garage Bucket Mirror" — registered for celestia only, so the idle
# nodes carrying this same token never push against it.
GARAGE_MIRROR_INTERVAL_SECONDS=21600
GARAGE_MIRROR_BUCKET=garage-mirror
GARAGE_MIRROR_UPTIME_URL=$UPTIME_API_URL
GARAGE_MIRROR_UPTIME_TOKEN=dockge-garage-bucket-mirror_${DOCKGE_NAME}
