NB_MANAGEMENT_URL="https://netbird.${searchDomain}"
NB_SETUP_KEY="ref+openbao://secrets/third-party-tokens/netbird/setup-keys#/gateway-${CLUSTER_KEY}"
NB_HOSTNAME="gateway-${CLUSTER_KEY}"
# A gateway advertises routes and never installs other peers' routes: it
# already reaches its LAN directly, and taking a route for it through another
# gateway would loop.
NB_DISABLE_CLIENT_ROUTES="true"
# Keep the host's resolver; NetBird's nameserver group is for client devices.
NB_DISABLE_DNS="true"
# NB_DISABLE_DNS alone does not keep NetBird off :53: its resolver still binds
# <wt0 address>:53, and this container is on the HOST network, where the
# technitium stack publishes 0.0.0.0:53. Whichever starts first wins; after
# skystar rebooted on 2026-11-27 the gateway won, so technitium-ts could not
# bind ("address already in use") and the site had no DNS overnight.
# Park the resolver on loopback, and not on 127.0.0.1: off port 53, NetBird
# also adds an nftables OUTPUT DNAT sending the namespace's 127.0.0.1:53 to
# itself -- here that namespace is the host's (see docker/_common/technitium/
# netbird.env). Applies only on a fresh enrolment: an enrolled gateway needs a
# one-off `netbird down; netbird up --dns-resolver-address 127.0.0.153:5053`.
NB_DNS_RESOLVER_ADDRESS="127.0.0.153:5053"
NB_LOG_LEVEL="info"
