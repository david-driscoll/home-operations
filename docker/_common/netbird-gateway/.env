NB_MANAGEMENT_URL="https://netbird.${searchDomain}"
NB_SETUP_KEY="ref+openbao://secrets/third-party-tokens/netbird/setup-keys#/gateway-${CLUSTER_KEY}"
NB_HOSTNAME="gateway-${CLUSTER_KEY}"
# A gateway advertises routes and never installs other peers' routes: it
# already reaches its LAN directly, and taking a route for it through another
# gateway would loop.
NB_DISABLE_CLIENT_ROUTES="true"
# Keep the host's resolver; NetBird's nameserver group is for client devices.
NB_DISABLE_DNS="true"
NB_LOG_LEVEL="info"
